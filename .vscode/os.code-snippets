  "Producer-Consumer": {
    "scope": "c",
    "prefix": "pc",
    "body": [
      "semaphore mutex = 1;",
      "semaphore empty = 10;",
      "semaphore full = 0;",
      "int buffer[10];",
      "int in = 0;",
      "int out = 0;",
      "",
      "void producer() {",
      "    int item = 0;",
      "    while (1) {",
      "        item = item + 1;",
      "        P(empty);",
      "        P(mutex);",
      "        buffer[in] = item;",
      "        in = (in + 1) % 10;",
      "        printf(\"produced %d\\n\", item);",
      "        V(mutex);",
      "        V(full);",
      "    }",
      "}",
      "",
      "void consumer() {",
      "    int item = 0;",
      "    while (1) {",
      "        P(full);",
      "        P(mutex);",
      "        item = buffer[out];",
      "        out = (out + 1) % 10;",
      "        printf(\"consumed %d\\n\", item);",
      "        V(mutex);",
      "        V(empty);",
      "    }",
      "}"
    ],
    "description": "Producer-consumer skeleton"
  }
}

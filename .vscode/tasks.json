{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vm: run current file",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "vm",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "vm: run current file (no trace)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "vm",
        "${file}",
        "--no-trace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}

{
  "files.associations": {
    "*.os": "c"
  },
  "[c]": {
    "editor.tabCompletion": "onlySnippets",
    "editor.snippetSuggestions": "top",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.wordBasedSuggestions": "currentDocument",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.autoIndent": "full"
  }
}
